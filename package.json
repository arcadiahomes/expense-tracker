{
  "name": "site-ledger",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "admin:bootstrap": "tsx --conditions=react-server --env-file-if-exists=.env src/db/admin.ts bootstrap",
    "admin:reset-link": "tsx --conditions=react-server --env-file-if-exists=.env src/db/admin.ts reset-link",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "next build && playwright test",
    "e2e:only": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@base-ui/react": "^1.9.0",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
